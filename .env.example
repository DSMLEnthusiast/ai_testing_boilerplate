# GitHub Copilot SDK Configuration
# Copy this file to .env and fill in your values for local development

# GitHub Personal Access Token (for Copilot SDK authentication)
# Required to run live agent tests (RUN_LLM_EVALS=1)
# Create at: https://github.com/settings/tokens
COPILOT_GITHUB_TOKEN=ghp_your_pat_here

# Live-test backend: mcp uses tools directly; agent loads .github/agents/math_agent
COPILOT_BACKEND=mcp

# Copilot model for agent execution (optional, defaults to gpt-5-mini)
COPILOT_MODEL=gpt-5-mini

# Model for judge evaluation (optional, defaults to gpt-5-mini)
# Used by DeepEval metrics in test_scenarios_live.py
COPILOT_JUDGE_MODEL=gpt-5-mini
